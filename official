-- ─────────────────────────────────────────────────────────────── coins
local function collectCoins()
	local folder = workspace:FindFirstChild("CoinContainer") or workspace:FindFirstChild("Coins")
	local candidates = {}

	if folder then
		for _, obj in ipairs(folder:GetChildren()) do
			candidates[#candidates + 1] = obj
		end
	else
		for _, obj in ipairs(workspace:GetChildren()) do
			if string.find(string.lower(obj.Name), "coin") then
				candidates[#candidates + 1] = obj
			end
		end
	end

	return candidates
end

local function updateCoins()
	if not (State.CoinEsp or State.CoinFarm) then
		for _, entry in pairs(CoinObjects) do
			if entry.billboard then
				entry.billboard:Destroy()
			end
		end
		CoinObjects = {}
		return
	end

	local coins = collectCoins()

	for _, coin in ipairs(coins) do
		local part = coin:IsA("BasePart") and coin or coin:FindFirstChildWhichIsA("BasePart")
		if part then
			local entry = CoinObjects[coin]
			if not entry then
				entry = { part = part, billboard = nil }
				CoinObjects[coin] = entry
			else
				entry.part = part
			end

			if State.CoinEsp and not entry.billboard then
				local billboard = new("BillboardGui", {
					Name = "MM2Coin",
					Size = UDim2.new(0, 90, 0, 14),
					StudsOffset = Vector3.new(0, 1, 0),
					AlwaysOnTop = true,
					MaxDistance = CONFIG.EspMaxDistance,
				}, part)

				new("TextLabel", {
					Size = UDim2.new(1, 0, 1, 0),
					BackgroundTransparency = 1,
					Font = Enum.Font.Code,
					Text = "COIN",
					TextSize = 10,
					TextColor3 = Color3.fromRGB(255, 214, 64),
					TextStrokeTransparency = 0.4,
				}, billboard)

				entry.billboard = billboard
			elseif not State.CoinEsp and entry.billboard then
				entry.billboard:Destroy()
				entry.billboard = nil
			end
		end
	end

	-- drop entries for coins that no longer exist
	for coin, entry in pairs(CoinObjects) do
		if not coin.Parent then
			if entry.billboard then
				entry.billboard:Destroy()
			end
			CoinObjects[coin] = nil
		end
	end

	if State.CoinFarm then
		local myRoot = rootOf(LocalPlayer)
		if not myRoot then
			return
		end
		local best, bestDist = nil, (State.CoinRange or CONFIG.CoinRange)
		for _, entry in pairs(CoinObjects) do
			if entry.part and entry.part.Parent then
				local dist = flatDistance(myRoot.Position, entry.part.Position)
				if dist < bestDist then
					best = entry.part
					bestDist = dist
				end
			end
		end
		if best then
			myRoot.CFrame = CFrame.new(best.Position + Vector3.new(0, 3, 0))
		end
	end
end

-- ─────────────────────────────────────────────────────────────── combat
local function aimAt(position)
	local myRoot = rootOf(LocalPlayer)
	if not myRoot then
		return
	end
	Camera.CFrame = CFrame.new(Camera.CFrame.Position, position)
end

local function toolInHand(name)
	local char = LocalPlayer.Character
	if not char then
		return nil
	end
	local tool = char:FindFirstChild(name)
	if tool and tool:IsA("Tool") then
		return tool
	end
	return nil
end

local function equipTool(name)
	local char = LocalPlayer.Character
	if not char then
		return nil
	end
	local held = toolInHand(name)
	if held then
		return held
	end
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	local pack = LocalPlayer:FindFirstChildOfClass("Backpack")
	local tool = pack and pack:FindFirstChild(name)
	if tool and humanoid then
		humanoid:EquipTool(tool)
		return tool
	end
	return nil
end

-- EquipTool reparents the tool on a later frame, so Activate() on the same tick
-- is a silent no-op that still burns the cooldown. This fires the equip request
-- once, then reports "not ready" until the tool is genuinely in the character;
-- the caller retries on the next pass. Never yields, so the heartbeat is safe.
local equipRequested = {}

local function armedTool(name)
	local held = toolInHand(name)
	if held then
		equipRequested[name] = nil
		return held
	end

	local now = os.clock()
	local last = equipRequested[name]
	if last and now - last < 1 then
		return nil
	end

	local char = LocalPlayer.Character
	if not char then
		return nil
	end
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	local pack = LocalPlayer:FindFirstChildOfClass("Backpack")
	local tool = pack and pack:FindFirstChild(name)
	if not (tool and humanoid) then
		return nil
	end

	equipRequested[name] = now
	pcall(function()
		humanoid:EquipTool(tool)
	end)
	return nil
end

local function activate(tool)
	if not tool then
		return false
	end
	local ok = pcall(function()
		tool:Activate()
	end)
	return ok
end

-- ─────────────────────────────────────────────────────────────── execution
-- Sheriff only. The gun is server-validated against the murderer's real
-- position, so this closes the gap physically, leads a moving target, fires,
-- then puts the sheriff back where they were. The restore is driven from the
-- tick loop rather than a task.delay so a respawn mid-swing can't strand you
-- in the murderer's face.
local execReturn = nil
local execClock = 0
local execKills = 0
local lastExecTarget = nil

local function murdererOf(range)
	local myRoot = rootOf(LocalPlayer)
	if not myRoot then
		return nil, math.huge
	end
	local best, bestDist = nil, (range or State.ExecRange or CONFIG.ExecRange)
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and alive(player) and RoleCache[player] == "Murderer" then
			local root = rootOf(player)
			local d = flatDistance(myRoot.Position, root and root.Position)
			if d < bestDist then
				best, bestDist = player, d
			end
		end
	end
	return best, bestDist
end

local function restorePosition()
	if not execReturn then
		return false
	end
	if os.clock() < execReturn.at then
		return true
	end
	local myRoot = rootOf(LocalPlayer)
	if myRoot then
		myRoot.CFrame = execReturn.cframe
	end
	execReturn = nil
	return false
end

-- One shot at the murderer. `range` is the leash; `chase` physically closes the
-- gap first. The gun is server-validated against the murderer's real position,
-- so standing still and firing from 200 studs simply does not register.
local function shootMurderer(range, chase)
	if (RoleCache[LocalPlayer] or "") ~= "Sheriff" then
		return false
	end

	-- a restore is still in flight, or one just finished: don't fight it
	if restorePosition() then
		return false
	end

	local now = os.clock()
	if now - execClock < ((State.ExecIntervalMs or 280) / 1000) then
		return false
	end

	local target = murdererOf(range)
	if not target then
		return false
	end

	local myRoot = rootOf(LocalPlayer)
	local targetRoot = rootOf(target)
	if not myRoot or not targetRoot then
		return false
	end

	local gun = armedTool("Gun")
	if not gun then
		return false
	end

	-- lead the target so the shot lands where they are going to be
	local aimPos = targetRoot.Position
	local velocity = targetRoot.AssemblyLinearVelocity
	if velocity.Magnitude > 1 then
		aimPos = aimPos + velocity * CONFIG.ExecPredict
	end

	local dist = flatDistance(myRoot.Position, targetRoot.Position)

	if chase and dist > CONFIG.ExecStandoff then
		local dir = targetRoot.Position - myRoot.Position
		dir = Vector3.new(dir.X, 0, dir.Z)
		if dir.Magnitude < 0.01 then
			return false
		end
		dir = dir.Unit
		local spot = targetRoot.Position - dir * CONFIG.ExecStandoff
		local eye = spot + Vector3.new(0, 2.6, 0)
		execReturn = {
			cframe = myRoot.CFrame,
			at = os.clock() + CONFIG.ExecReturn,
		}
		myRoot.CFrame = CFrame.new(eye, Vector3.new(targetRoot.Position.X, eye.Y, targetRoot.Position.Z))
	end

	aimAt(aimPos)
	activate(gun)
	execClock = now
	lastExecTarget = target
	return true
end

-- Confirmation: the murderer we last fired at is no longer alive.
local function checkExecKill()
	if not lastExecTarget then
		return
	end
	if not lastExecTarget.Parent then
		lastExecTarget = nil
		return
	end
	if not alive(lastExecTarget) then
		execKills = execKills + 1
		notify("murderer down · " .. lastExecTarget.Name, ROLE_COLOR.Murderer)
		lastExecTarget = nil
	end
end

local function executionTick()
	-- both toggles are sheriff-only murderer killers; exec murderer reaches
	-- further, auto shoot stays inside aim range
	local hunting = State.ExecMurderer or State.AutoShoot

	checkExecKill()

	if not hunting then
		restorePosition()
		return
	end

	if (RoleCache[LocalPlayer] or "") ~= "Sheriff" then
		restorePosition()
		return
	end

	if State.ExecMurderer then
		-- aggressive: teleport-close, fire, snap back
		shootMurderer(State.ExecRange or CONFIG.ExecRange, true)
	elseif State.AutoShoot then
		-- stand and fire: leads and cooldowns, but never moves you
		shootMurderer(CONFIG.AimRange, false)
	end
end

-- ─────────────────────────────────────────────────────────────── backstab
-- Murderer only. MM2 registers a knife kill on the server-side touch of the
-- victim's body, so the swing has to originate from inside arm's reach and
-- from behind: place, face, swing, move on. Priority is random by default so
-- the same body isn't farmed twice in a row while the lobby is full.
local backstabReturn = nil
local backstabClock = 0
local backstabKills = 0
local lastBackstabTarget = nil

local function restoreBackstab()
	if not backstabReturn then
		return false
	end
	if os.clock() < backstabReturn.at then
		return true
	end
	local myRoot = rootOf(LocalPlayer)
	if myRoot then
		myRoot.CFrame = backstabReturn.cframe
	end
	backstabReturn = nil
	return false
end

local function backstabCandidates(range)
	local myRoot = rootOf(LocalPlayer)
	if not myRoot then
		return {}
	end
	local limit = range or State.BackstabRange or CONFIG.BackstabRange
	local out = {}
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and alive(player) then
			local role = RoleCache[player] or "Unknown"
			-- a murderer has no business stabbing the other murderer
			if role ~= "Murderer" then
				local root = rootOf(player)
				if root then
					local d = flatDistance(myRoot.Position, root.Position)
					if d <= limit then
						out[#out + 1] = { player = player, root = root, dist = d, role = role }
					end
				end
			end
		end
	end
	return out
end

local function pickBackstabTarget(range)
	local list = backstabCandidates(range)
	local count = #list
	if count == 0 then
		return nil
	end

	local mode = State.BackstabPriority or "random"

	if mode == "nearest" then
		local best = list[1]
		for i = 2, count do
			if list[i].dist < best.dist then
				best = list[i]
			end
		end
		return best
	end

	if mode == "sheriff" then
		for i = 1, count do
			if list[i].role == "Sheriff" then
				return list[i]
			end
		end
	end

	-- random: skip the body we just stabbed when there is another option
	if count > 1 and lastBackstabTarget then
		local pool = {}
		for i = 1, count do
			if list[i].player ~= lastBackstabTarget then
				pool[#pool + 1] = list[i]
			end
		end
		if #pool > 0 then
			list = pool
			count = #pool
		end
	end

	return list[math.random(1, count)]
end

-- Behind means opposite the target's LookVector, flattened so a falling or
-- ragdolled body doesn't drop us through the floor. The eye offset keeps the
-- camera above the target's shoulders instead of inside their spine.
local function placeBehind(entry)
	local myRoot = rootOf(LocalPlayer)
	if not myRoot or not entry.root or not entry.root.Parent then
		return false
	end

	local targetPos = entry.root.Position
	local velocity = entry.root.AssemblyLinearVelocity
	if State.BackstabPredict and velocity.Magnitude > 1 then
		targetPos = targetPos + velocity * CONFIG.BackstabPredict
	end

	local facing = entry.root.CFrame.LookVector
	facing = Vector3.new(facing.X, 0, facing.Z)
	if facing.Magnitude < 0.01 then
		facing = Vector3.new(0, 0, 1)
	end
	facing = facing.Unit

	local distance = State.BackstabDistance or CONFIG.BackstabDistance
	local spot = targetPos - facing * distance
	local eye = Vector3.new(spot.X, targetPos.Y + CONFIG.BackstabHeight, spot.Z)
	local look = Vector3.new(targetPos.X, eye.Y, targetPos.Z)

	myRoot.CFrame = CFrame.new(eye, look)
	aimAt(targetPos)
	return true
end

local function checkBackstabKill()
	if not lastBackstabTarget then
		return
	end
	if not lastBackstabTarget.Parent then
		lastBackstabTarget = nil
		return
	end
	-- only credit a kill to a swing we actually threw; a target who was already
	-- dead when we picked them would otherwise count on the next pass
	if os.clock() - backstabClock > 2 then
		return
	end
	if not alive(lastBackstabTarget) then
		backstabKills = backstabKills + 1
		notify("backstab · " .. lastBackstabTarget.Name, ROLE_COLOR.Murderer)
		lastBackstabTarget = nil
	end
end

local function backstabTick()
	checkBackstabKill()

	if not State.AutoBackstab or (RoleCache[LocalPlayer] or "") ~= "Murderer" then
		restoreBackstab()
		return
	end

	if restoreBackstab() then
		return -- a snap-back is still resolving
	end

	local now = os.clock()
	if now - backstabClock < ((State.BackstabIntervalMs or 300) / 1000) then
		return
	end

	local knife = armedTool("Knife")
	if not knife then
		return -- equip request in flight, swing on the next pass
	end

	local entry = pickBackstabTarget(State.BackstabRange)
	if not entry then
		return
	end

	local myRoot = rootOf(LocalPlayer)
	if not myRoot then
		return
	end

	local origin = myRoot.CFrame
	if not placeBehind(entry) then
		return
	end

	-- optional snap-back: only worth it if the jump would strand us somewhere
	-- visible, and it costs a frame of blade time, so it is off by default
	if State.BackstabReturn then
		backstabReturn = { cframe = origin, at = os.clock() + CONFIG.BackstabReturn }
	end

	activate(knife)
	backstabClock = now
	lastBackstabTarget = entry.player
end

local function combatTick()
	-- auto shoot lives in executionTick so it shares the murderer spine
	if not (State.AimAssist or State.AutoThrow or State.KillAura or State.AutoKnife) then
		return
	end
	local myRole = RoleCache[LocalPlayer] or "Innocent"
	local myRoot = rootOf(LocalPlayer)
	if not myRoot then
		return
	end

	-- an innocent has nothing worth swinging at
	if myRole == "Innocent" then
		return
	end

	-- keep the right tool in hand so a throw or a swing never fires empty
	if State.AutoKnife and myRole == "Murderer" then
		armedTool("Knife")
	end

	-- nothing below this line needs a target unless a targeting toggle is on,
	-- and the full player sweep is not free at 20 Hz
	if not (State.AimAssist or State.AutoThrow or State.KillAura) then
		return
	end

	local target, dist, bestPrio = nil, math.huge, math.huge
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and alive(player) then
			local role = RoleCache[player] or "Unknown"
			local isTarget = false
			local prio = 1

			if myRole == "Sheriff" then
				isTarget = (role == "Murderer")
			else
				isTarget = (role == "Innocent" or role == "Sheriff")
				-- the sheriff is the only one who can shoot back: take them first
				if role == "Sheriff" and State.TargetSheriff then
					prio = 0
				end
			end

			if isTarget then
				local root = rootOf(player)
				local d = flatDistance(myRoot.Position, root and root.Position)
				if prio < bestPrio or (prio == bestPrio and d < dist) then
					target, dist, bestPrio = player, d, prio
				end
			end
		end
	end

	if not target then
		return
	end

	local targetRoot = rootOf(target)
	if not targetRoot then
		return
	end

	if State.AimAssist and dist <= CONFIG.AimRange then
		aimAt(targetRoot.Position)
	end

	if State.AutoThrow and myRole == "Murderer" and dist <= CONFIG.ThrowRange then
		local knife = armedTool("Knife")
		if knife then
			local aimPos = targetRoot.Position
			if State.ThrowPredict then
				local velocity = targetRoot.AssemblyLinearVelocity
				if velocity.Magnitude > 1 then
					aimPos = aimPos + velocity * 0.18
				end
			end
			aimAt(aimPos)
			activate(knife)
		end
	end

	-- auto backstab owns the root when it is on; letting kill aura drive it too
	-- makes the two teleports fight and neither swing lands
	if State.KillAura and not State.AutoBackstab and myRole == "Murderer" and dist <= CONFIG.KillRange then
		local knife = armedTool("Knife")
		if knife then
			myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 3)
			aimAt(targetRoot.Position)
			activate(knife)
		end
	end
end

-- ─────────────────────────────────────────────────────────────── pickup
local function pickupTick()
	if not State.AutoPickup then
		return
	end
	-- coin farm already owns the root; letting both drive it makes the player
	-- jitter between a coin and a dropped knife and reach neither
	if State.CoinFarm then
		return
	end
	local myRoot = rootOf(LocalPlayer)
	if not myRoot then
		return
	end

	for _, obj in ipairs(workspace:GetChildren()) do
		if obj:IsA("Tool") and (obj.Name == "Knife" or obj.Name == "Gun") then
			local handle = obj:FindFirstChild("Handle")
			if handle then
				local dist = flatDistance(myRoot.Position, handle.Position)
				if dist < 400 then
					myRoot.CFrame = CFrame.new(handle.Position + Vector3.new(0, 3, 0))
					return
				end
			end
		end
	end
end

-- ─────────────────────────────────────────────────────────────── movement
local function applyMovement()
	local char = LocalPlayer.Character
	if not char then
		return
	end
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end

	if State.WalkSpeed ~= humanoid.WalkSpeed then
		humanoid.WalkSpeed = State.WalkSpeed
	end
	if State.JumpPower ~= humanoid.JumpPower and State.JumpPower > 0 then
		humanoid.JumpPower = State.JumpPower
		humanoid.UseJumpPower = true
	end
end

local flyBodyVelocity
local flyBodyGyro

local function stopFly()
	if flyBodyVelocity then
		flyBodyVelocity:Destroy()
		flyBodyVelocity = nil
	end
	if flyBodyGyro then
		flyBodyGyro:Destroy()
		flyBodyGyro = nil
	end
end

local function flyTick()
	if not State.Fly then
		if flyBodyVelocity then
			stopFly()
		end
		return
	end

	local char = LocalPlayer.Character
	local root = rootOf(LocalPlayer)
	if not char or not root then
		return
	end

	if not flyBodyVelocity or flyBodyVelocity.Parent ~= root then
		stopFly()
		flyBodyVelocity = Instance.new("BodyVelocity")
		flyBodyVelocity.MaxForce = Vector3.new(1e5, 1e5, 1e5)
		flyBodyVelocity.Velocity = Vector3.zero
		flyBodyVelocity.Parent = root

		flyBodyGyro = Instance.new("BodyGyro")
		flyBodyGyro.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
		flyBodyGyro.P = 2000
		flyBodyGyro.Parent = root
	end

	local direction = Vector3.zero
	if UserInputService:IsKeyDown(Enum.KeyCode.W) then
		direction = direction + Camera.CFrame.LookVector
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.S) then
		direction = direction - Camera.CFrame.LookVector
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.A) then
		direction = direction - Camera.CFrame.RightVector
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.D) then
		direction = direction + Camera.CFrame.RightVector
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
		direction = direction + Vector3.new(0, 1, 0)
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
		direction = direction - Vector3.new(0, 1, 0)
	end

	if direction.Magnitude > 0 then
		direction = direction.Unit * CONFIG.FlySpeed
	end

	flyBodyVelocity.Velocity = direction
	flyBodyGyro.CFrame = Camera.CFrame
end

-- Part list is rebuilt only when the character changes. Walking
-- GetDescendants() every frame walked the whole rig 60x a second for nothing.
local noclipChar = nil
local noclipParts = {}

local function noclipRestore()
	for part, original in pairs(noclipParts) do
		if part.Parent then
			part.CanCollide = original
		end
	end
	noclipParts = {}
	noclipChar = nil
end

local function noclipTick()
	if not State.Noclip then
		if noclipChar then
			noclipRestore()
		end
		return
	end

	local char = LocalPlayer.Character
	if not char then
		if noclipChar then
			noclipRestore()
		end
		return
	end

	if char ~= noclipChar then
		noclipChar = char
		noclipParts = {}
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") then
				noclipParts[part] = part.CanCollide
			end
		end
	end

	for part in pairs(noclipParts) do
		if part.Parent and part.CanCollide then
			part.CanCollide = false
		end
	end
end

