	end
end)

-- ─────────────────────────────────────────────────────────────── anti afk
-- Preferred path: kill the Idled connections so the kick never fires.
-- Fallback for executors without getconnections: poke VirtualUser on the same
-- signal, which resets the 20-minute idle timer.
do
	local severed = false
	if type(getconnections) == "function" then
		pcall(function()
			for _, conn in ipairs(getconnections(LocalPlayer.Idled)) do
				conn:Disconnect()
			end
			severed = true
		end)
	end

	if not severed then
		LocalPlayer.Idled:Connect(function()
			if not State.AntiAfk then
				return
			end
			local vu = game:GetService("VirtualUser")
			pcall(function()
				vu:CaptureController()
				vu:ClickButton2(Vector2.new())
			end)
		end)
	end
end

-- ─────────────────────────────────────────────────────────────── loops
local roleClock = 0
local espClock = 0
local coinClock = 0
local pickupClock = 0
local combatClock = 0
local threatClock = 0
local saveClock = 0

refreshRoles()

RunService.Heartbeat:Connect(function()
	local now = os.clock()

	if now - roleClock >= CONFIG.RefreshRate then
		roleClock = now
		refreshRoles()

		local myRole = RoleCache[LocalPlayer] or "…"
		setRoleChip(myRole)

		local murderers, sheriffs = 0, 0
		for _, player in ipairs(Players:GetPlayers()) do
			local role = RoleCache[player]
			if role == "Murderer" then
				murderers = murderers + 1
			elseif role == "Sheriff" then
				sheriffs = sheriffs + 1
			end
		end
		statusLabel.Text = string.format("%dM %dS %dP", murderers, sheriffs, #Players:GetPlayers())
		killLabel.Text = string.format("%d stab · %d shot", backstabKills, execKills)
		if refreshCounts then
			refreshCounts()
		end
	end

	-- threat bar: how close the nearest living murderer is, 4x a second
	if now - threatClock >= 0.25 then
		threatClock = now
		local myRoot = rootOf(LocalPlayer)
		local nearest = math.huge
		if myRoot then
			for _, player in ipairs(Players:GetPlayers()) do
				if player ~= LocalPlayer and alive(player) and RoleCache[player] == "Murderer" then
					local root = rootOf(player)
					local d = flatDistance(myRoot.Position, root and root.Position)
					if d < nearest then
						nearest = d
					end
				end
			end
		end

		if nearest == math.huge then
			threatFill.Size = UDim2.new(0, 0, 1, 0)
			threatText.Text = "clear"
			threatText.TextColor3 = Theme.Stroke
		else
			local ratio = math.clamp(1 - nearest / 320, 0.03, 1)
			threatFill.Size = UDim2.new(ratio, 0, 1, 0)
			threatFill.BackgroundColor3 = ratio > 0.7 and ROLE_COLOR.Murderer
				or (ratio > 0.4 and Color3.fromRGB(255, 160, 60) or ROLE_COLOR.Innocent)
			threatText.Text = string.format("%dm · %d%%", math.floor(nearest), math.floor(ratio * 100))
			threatText.TextColor3 = threatFill.BackgroundColor3
		end
	end

	if now - espClock >= CONFIG.EspRate then
		espClock = now
		updateEsp()
	end

	if now - coinClock >= 0.5 then
		coinClock = now
		updateCoins()
	end

	if now - pickupClock >= 0.3 then
		pickupClock = now
		pickupTick()
	end

	if now - combatClock >= 0.05 then
		combatClock = now
		executionTick()
		combatTick()
		backstabTick()
	end

	-- one write every two seconds at most, and only after a change
	if saveDirty and now - saveClock >= 2 then
		saveClock = now
		saveDirty = false
		saveState()
	end

	applyMovement()
	flyTick()
	noclipTick()
	applyVisuals()
end)

