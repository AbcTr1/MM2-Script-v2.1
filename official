-- Nameplates, tracers and chams are three independent toggles. v2.0 nested all
-- of them under State.Esp, so tracers and chams never fired on their own.
local function updateEsp()
	local myRoot = rootOf(LocalPlayer)
	local viewport = (Camera and Camera.ViewportSize) or Vector2.new(1920, 1080)
	local drawingType = type(Drawing)
	local hasDrawing = (drawingType == "table" or drawingType == "userdata")

	for _, player in ipairs(Players:GetPlayers()) do
		if player == LocalPlayer then
			continue
		end

		local char = player.Character
		local root = rootOf(player)
		local head = char and char:FindFirstChild("Head")
		local role = RoleCache[player] or "Unknown"
		local color = roleColor(role)

		-- ── nameplate · role · health · distance
		if State.Esp and playerGui then
			if not EspObjects[player] then
				buildEspFor(player)
			end
			local data = EspObjects[player]
			if data then
				if data.billboard.Parent ~= playerGui then
					data.billboard.Parent = playerGui
				end
				data.billboard.Adornee = head
				data.billboard.Enabled = head ~= nil

				data.role.Text = string.upper(role)
				data.role.TextColor3 = color
				data.name.TextColor3 = State.ShowRoles and color or Theme.Text

				local humanoid = char and char:FindFirstChildOfClass("Humanoid")
				local hp = 0
				if humanoid then
					hp = math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1)
				end
				data.healthTrack.Visible = humanoid ~= nil
				data.healthFill.Size = UDim2.new(hp, 0, 1, 0)
				data.healthFill.BackgroundColor3 = hp > 0.6 and ROLE_COLOR.Innocent
					or (hp > 0.3 and Color3.fromRGB(255, 176, 0) or ROLE_COLOR.Murderer)

				if root and myRoot then
					data.distance.Text = string.format("%dm", math.floor(flatDistance(myRoot.Position, root.Position)))
				else
					data.distance.Text = ""
				end
			end
		elseif EspObjects[player] then
			EspObjects[player].billboard:Destroy()
			EspObjects[player] = nil
		end

		-- ── tracer
		if State.Tracers and hasDrawing and root and Camera then
			local line = Tracers[player]
			if not line then
				line = Drawing.new("Line")
				line.Thickness = 1
				line.Transparency = 0.7
				line.Visible = false
				Tracers[player] = line
			end
			local screen, onScreen = Camera:WorldToViewportPoint(root.Position)
			if onScreen then
				line.From = Vector2.new(viewport.X / 2, viewport.Y)
				line.To = Vector2.new(screen.X, screen.Y)
				line.Color = color
				line.Visible = true
			else
				line.Visible = false
			end
		else
			killTracer(player)
		end

		-- ── chams · a Highlight dies with the character it adorns
		if State.Chams and char then
			local highlight = Highlights[player]
			if highlight and not highlight.Parent then
				highlight = nil
				Highlights[player] = nil
			end
			if not highlight then
				highlight = Instance.new("Highlight")
				highlight.Name = "MM2Cham"
				highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				highlight.FillTransparency = 0.65
				highlight.OutlineTransparency = 0
				highlight.Parent = char
				Highlights[player] = highlight
			end
			if highlight.Parent ~= char then
				highlight.Parent = char
			end
			highlight.Adornee = char
			highlight.FillColor = color
			highlight.OutlineColor = color
		else
			local highlight = Highlights[player]
			if highlight then
				highlight:Destroy()
				Highlights[player] = nil
			end
		end
	end
end

