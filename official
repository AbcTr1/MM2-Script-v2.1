-- ── role chip ────────────────────────────────────────────────────────────────
local lastRoleShown = nil

local function setRoleChip(role)
	if role == lastRoleShown then
		return
	end
	lastRoleShown = role

	local color = roleColor(role)
	roleChip.Text = string.upper(role)
	roleChip.TextColor3 = color
	roleChipStroke.Color = color
	roleChipStroke.Transparency = 0.35
	roleChip.TextSize = 13
	tweenAs(roleChip, 0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, { TextSize = 10 })

	local flash = new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = color,
		BackgroundTransparency = 0.8,
		BorderSizePixel = 0,
		ZIndex = 1,
	}, roleChip)

	local anim = tweenAs(flash, 0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, {
		BackgroundTransparency = 1,
	})
	anim.Completed:Once(function()
		flash:Destroy()
	end)

	if role == "Sheriff" then
		notify("sheriff · gun loaded", color)
	elseif role == "Murderer" then
		notify("murderer · knife out", color)
	end
end

