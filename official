-- ─────────────────────────────────────────────────────────────── api
local api = {}
api.State = State
api.Config = CONFIG
api.Roles = RoleCache
api.Refresh = refreshRoles
api.Notify = notify
api.Panel = setOpen

function api.Set(key, value)
	if State[key] == nil then
		return false
	end
	State[key] = value
	saveDirty = true
	for _, row in ipairs(rows) do
		if row.key == key then
			row.paint()
		end
	end
	local paintSlider = sliderPaints[key]
	if paintSlider then
		for _, paint in ipairs(paintSlider) do
			paint()
		end
	end
	if refreshCounts then
		refreshCounts()
	end
	return true
end

function api.SetEsp(value)
	return api.Set("Esp", value)
end

function api.Toggle(key)
	if key == nil then
		setOpen(not open)
		return open
	end
	return api.Set(key, not State[key])
end

function api.Tab(name)
	for _, p in ipairs(pages) do
		if p.name == name then
			activeTab = name
			currentPage = p.frame
			paintTabs()
			return true
		end
	end
	return false
end

function api.Exec()
	return {
		enabled = State.ExecMurderer,
		autoShoot = State.AutoShoot,
		kills = execKills,
		range = State.ExecRange or CONFIG.ExecRange,
	}
end

function api.Backstab()
	return {
		enabled = State.AutoBackstab,
		range = State.BackstabRange or CONFIG.BackstabRange,
		distance = State.BackstabDistance or CONFIG.BackstabDistance,
		intervalMs = State.BackstabIntervalMs or 300,
		priority = State.BackstabPriority or "random",
		kills = backstabKills,
		target = lastBackstabTarget and lastBackstabTarget.Name or nil,
	}
end

function api.Kills()
	return { backstab = backstabKills, shot = execKills }
end

function api.Equip(name)
	return equipTool(name)
end

function api.Credits()
	return string.format("Discord - %s / Roblox - %s", CREDITS.Discord, CREDITS.Roblox)
end

