local savedLighting = {
	Brightness = Lighting.Brightness,
	ClockTime = Lighting.ClockTime,
	FogEnd = Lighting.FogEnd,
	Ambient = Lighting.Ambient,
	OutdoorAmbient = Lighting.OutdoorAmbient,
}

-- Lighting writes replicate to the server every frame if they are left
-- unguarded, so the pass only fires when one of the two toggles changes.
local visualsSignature = nil

local function applyVisuals()
	local signature = (State.Fullbright and "f" or "-") .. (State.NoFog and "g" or "-")
	if signature == visualsSignature then
		return
	end
	visualsSignature = signature

	if State.Fullbright then
		Lighting.Brightness = 3
		Lighting.ClockTime = 14
		Lighting.Ambient = Color3.fromRGB(180, 180, 180)
		Lighting.OutdoorAmbient = Color3.fromRGB(180, 180, 180)
	else
		Lighting.Brightness = savedLighting.Brightness
		Lighting.ClockTime = savedLighting.ClockTime
		Lighting.Ambient = savedLighting.Ambient
		Lighting.OutdoorAmbient = savedLighting.OutdoorAmbient
	end

	if State.NoFog then
		Lighting.FogEnd = 1e6
	else
		Lighting.FogEnd = savedLighting.FogEnd
	end
end

