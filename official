-- ── tab counters ─────────────────────────────────────────────────────────────
local function refreshCountsImpl()
	for _, t in ipairs(tabs) do
		local seen = {}
		local on, total = 0, 0
		for _, key in ipairs(t.keys) do
			if not seen[key] then
				seen[key] = true
				total = total + 1
				if State[key] then
					on = on + 1
				end
			end
		end
		t.count.Text = (total > 0) and string.format("%d/%d", on, total) or ""
	end
end

refreshCounts = refreshCountsImpl

-- ── open / close ─────────────────────────────────────────────────────────────
local open = false

local function setOpen(value)
	if value == open then
		return
	end
	open = value

	if value then
		main.Visible = true
		scale.Scale = 0.92
		surface.BackgroundTransparency = 1
		surfaceStroke.Transparency = 1

		tweenAs(scale, 0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out, { Scale = 1 })
		tweenAs(surface, 0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, {
			BackgroundTransparency = 0.02,
		})
		tweenAs(surfaceStroke, 0.26, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, {
			Transparency = 0.6,
		})
	else
		tweenAs(scale, 0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In, { Scale = 0.92 })
		tweenAs(surface, 0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In, {
			BackgroundTransparency = 1,
		})
		tweenAs(surfaceStroke, 0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In, {
			Transparency = 1,
		})

		task.delay(0.17, function()
			if not open then
				main.Visible = false
			end
		end)
	end
end

