local function notify(text, color)
	if not NotifyGui then
		return
	end
	local label = new("TextLabel", {
		Size = UDim2.new(0, 220, 0, 26),
		Position = UDim2.new(0.5, -110, 0, -40),
		BackgroundColor3 = Theme.Panel,
		BackgroundTransparency = 0.15,
		BorderSizePixel = 0,
		Font = Enum.Font.Code,
		Text = text,
		TextSize = 12,
		TextColor3 = color or Theme.Accent,
	}, NotifyGui)

	local stroke = Instance.new("UIStroke")
	stroke.Color = color or Theme.Accent
	stroke.Thickness = 1
	stroke.Transparency = 0.5
	stroke.Parent = label

	tween(label, 0.18, { Position = UDim2.new(0.5, -110, 0, 18), BackgroundTransparency = 0.15 })
	task.delay(1.8, function()
		tween(label, 0.25, { BackgroundTransparency = 1, TextTransparency = 1 })
		task.wait(0.3)
		label:Destroy()
	end)
end

