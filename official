-- ─────────────────────────────────────────────────────────────── helpers
local function round(n)
	return math.floor(n + 0.5)
end

local function new(class, props, parent)
	local obj = Instance.new(class)
	for key, value in pairs(props) do
		obj[key] = value
	end
	if parent then
		obj.Parent = parent
	end
	return obj
end

local function tween(obj, time, props)
	local info = TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local anim = TweenService:Create(obj, info, props)
	anim:Play()
	return anim
end

local function alive(player)
	local char = player.Character
	if not char then
		return false
	end
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	return humanoid ~= nil and humanoid.Health > 0
end

local function rootOf(player)
	local char = player.Character
	if not char then
		return nil
	end
	return char:FindFirstChild("HumanoidRootPart")
end

local function flatDistance(a, b)
	if not a or not b then
		return math.huge
	end
	local d = a - b
	return math.sqrt(d.X * d.X + d.Z * d.Z)
end

local function hasTool(player, name)
	local char = player.Character
	if char and char:FindFirstChild(name) then
		return true, char:FindFirstChild(name)
	end
	local pack = player:FindFirstChildOfClass("Backpack")
	if pack then
		local tool = pack:FindFirstChild(name)
		if tool then
			return true, tool
		end
	end
	return false, nil
end

-- ─────────────────────────────────────────────────────────────── persistence
-- Toggle + slider values survive a rejoin when the executor exposes file io.
-- Anything missing (readfile / writefile / JSON) fails closed: the script runs
-- on its own defaults instead of erroring at load.
local saveDirty = false

local function loadSaved()
	if not CONFIG.Persist then
		return nil
	end
	if type(readfile) ~= "function" then
		return nil
	end
	local ok, raw = pcall(readfile, CONFIG_FILE)
	if not ok or type(raw) ~= "string" or #raw == 0 then
		return nil
	end
	local decoded
	local ok2 = pcall(function()
		decoded = HttpService:JSONDecode(raw)
	end)
	if not ok2 or type(decoded) ~= "table" then
		return nil
	end
	return decoded
end

local function saveState()
	if not CONFIG.Persist or type(writefile) ~= "function" then
		return false
	end
	local out = {}
	for key, value in pairs(State) do
		if type(value) == "boolean" or type(value) == "number" then
			out[key] = value
		end
	end
	local encoded
	local ok = pcall(function()
		encoded = HttpService:JSONEncode(out)
	end)
	if not ok or type(encoded) ~= "string" then
		return false
	end
	local ok2 = pcall(writefile, CONFIG_FILE, encoded)
	return ok2
end

local function initialState(key, default)
	if saved and saved[key] ~= nil and type(saved[key]) == type(default) then
		return saved[key]
	end
	return default
end

saved = loadSaved()

-- ─────────────────────────────────────────────────────────────── roles
-- MM2 exposes the role through attributes on newer builds; older builds only
-- expose the tools. Both are checked, tools last because they are reliable.
local function detectRole(player)
	local ok, attr = pcall(function()
		return player:GetAttribute("Role")
	end)
	if ok and type(attr) == "string" and attr ~= "" then
		local lower = string.lower(attr)
		if string.find(lower, "murder") then
			return "Murderer"
		elseif string.find(lower, "sheriff") then
			return "Sheriff"
		elseif string.find(lower, "innocent") then
			return "Innocent"
		end
	end

	if not alive(player) then
		return "Dead"
	end

	local knife = hasTool(player, "Knife")
	if knife then
		return "Murderer"
	end

	local gun = hasTool(player, "Gun")
	if gun then
		return "Sheriff"
	end

	return "Innocent"
end

local function roleColor(role)
	return ROLE_COLOR[role] or ROLE_COLOR.Unknown
end

local function refreshRoles()
	for player in pairs(RoleCache) do
		RoleCache[player] = nil
	end
	for _, player in ipairs(Players:GetPlayers()) do
		RoleCache[player] = detectRole(player)
	end
end

