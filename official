	}, row)

	local label = new("TextLabel", {
		Size = UDim2.new(1, -62, 1, 0),
		Position = UDim2.fromOffset(12, 0),
		BackgroundTransparency = 1,
		Font = Enum.Font.Code,
		Text = name,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Theme.Dim,
		ZIndex = 2,
	}, row)

	local pill = new("Frame", {
		Size = UDim2.fromOffset(36, 20),
		Position = UDim2.new(1, -48, 0.5, -10),
		BackgroundColor3 = Theme.Window,
		BorderSizePixel = 0,
		ZIndex = 2,
	}, row)

	new("UICorner", { CornerRadius = UDim.new(1, 0) }, pill)

	local pillStroke = Instance.new("UIStroke")
	pillStroke.Color = Theme.Stroke
	pillStroke.Thickness = 1
	pillStroke.Transparency = 0.55
	pillStroke.Parent = pill

	local dot = new("Frame", {
		Size = UDim2.fromOffset(14, 14),
		Position = UDim2.fromOffset(3, 3),
		BackgroundColor3 = Theme.Dim,
		BorderSizePixel = 0,
		ZIndex = 3,
	}, pill)

	new("UICorner", { CornerRadius = UDim.new(1, 0) }, dot)

	local function paint(animate)
		local on = State[key]
		local time = (animate == false) and 0.001 or 0.24

		if on then
			dot.BackgroundColor3 = Theme.Accent
			tweenAs(dot, time, Enum.EasingStyle.Back, Enum.EasingDirection.Out, {
				Position = UDim2.fromOffset(19, 3),
			})
			label.TextColor3 = Theme.Text
			stroke.Transparency = 0.7
			bar.BackgroundTransparency = 0
			row.BackgroundTransparency = 0.24
			pillStroke.Transparency = 0.2
		else
			dot.BackgroundColor3 = Theme.Dim
			tweenAs(dot, time, Enum.EasingStyle.Back, Enum.EasingDirection.Out, {
				Position = UDim2.fromOffset(3, 3),
			})
			label.TextColor3 = Theme.Dim
			stroke.Transparency = 1
			bar.BackgroundTransparency = 1
			row.BackgroundTransparency = 0.45
			pillStroke.Transparency = 0.55
		end
	end

	row.MouseEnter:Connect(function()
		if not State[key] then
			tweenAs(row, 0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, {
				BackgroundTransparency = 0.3,
			})
		end
	end)

	row.MouseLeave:Connect(function()
		if not State[key] then
			tweenAs(row, 0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, {
				BackgroundTransparency = 0.45,
			})
		end
	end)

	row.MouseButton1Click:Connect(function()
		State[key] = not State[key]
		saveDirty = true
		syncKey(key)
		if refreshCounts then
			refreshCounts()
		end
	end)

	paint(false)
	rows[#rows + 1] = { key = key, paint = paint }
	rowSync[key] = rowSync[key] or {}
	table.insert(rowSync[key], paint)

	local owner = tabs[#tabs]
	if owner then
		table.insert(owner.keys, key)
	end

	return row
end

-- One drag pair for every slider on the panel. v2.0 registered three
-- UserInputService connections per slider, so six sliders leaked eighteen.
local activeSlider = nil
local sliderPaints = {}

UserInputService.InputChanged:Connect(function(input)
	if not activeSlider then
		return
	end
	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then
		activeSlider(input.Position.X)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		activeSlider = nil
	end
end)

local function slider(name, key, min, max, default, suffix)
	order = order + 1

	local start = initialState(key, default)
	if type(start) ~= "number" then
		start = default
	end
	start = math.clamp(start, min, max)
	State[key] = start

	local holder = new("Frame", {
		Size = UDim2.new(1, 0, 0, 54),
		BackgroundColor3 = Theme.Panel,
		BackgroundTransparency = 0.45,
		BorderSizePixel = 0,
		LayoutOrder = order,
	}, currentFull or currentPage)

	new("UICorner", { CornerRadius = UDim.new(0, 6) }, holder)

	new("TextLabel", {
		Size = UDim2.new(1, -80, 0, 16),
		Position = UDim2.fromOffset(12, 8),
		BackgroundTransparency = 1,
		Font = Enum.Font.Code,
		Text = name,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Theme.Text,
	}, holder)

	local valueLabel = new("TextLabel", {
		Size = UDim2.fromOffset(70, 16),
		Position = UDim2.new(1, -82, 0, 8),
		BackgroundTransparency = 1,
		Font = Enum.Font.Code,
		Text = tostring(default) .. (suffix or ""),
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = Theme.Accent,
	}, holder)

	local track = new("Frame", {
		Size = UDim2.new(1, -24, 0, 4),
		Position = UDim2.new(0, 12, 0, 38),
		BackgroundColor3 = Theme.Stroke,
		BackgroundTransparency = 0.7,
		BorderSizePixel = 0,
	}, holder)

	new("UICorner", { CornerRadius = UDim.new(1, 0) }, track)

	local fill = new("Frame", {
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
	}, track)

	new("UICorner", { CornerRadius = UDim.new(1, 0) }, fill)

	local knob = new("Frame", {
		Size = UDim2.fromOffset(12, 12),
		Position = UDim2.new(0, 0, 0.5, -6),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		ZIndex = 2,
	}, holder)

	new("UICorner", { CornerRadius = UDim.new(1, 0) }, knob)

	local function setRatio(ratio)
		ratio = math.clamp(ratio, 0, 1)
		local value = round(min + (max - min) * ratio)
		State[key] = value
		saveDirty = true
		fill.Size = UDim2.new(ratio, 0, 1, 0)
		knob.Position = UDim2.new(ratio, -6, 0.5, -6)
		valueLabel.Text = tostring(value) .. (suffix or "")
	end

	local function setValue(px)
		local width = track.AbsoluteSize.X
		if width <= 0 then
			return
		end
		setRatio((px - track.AbsolutePosition.X) / width)
	end

	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			activeSlider = setValue
			setValue(input.Position.X)
		end
	end)

	knob.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			activeSlider = setValue
		end
	end)

	setRatio((start - min) / (max - min))

	sliderPaints[key] = sliderPaints[key] or {}
	table.insert(sliderPaints[key], function()
		local value = State[key]
		if type(value) ~= "number" then
			return
		end
		local ratio = math.clamp((value - min) / (max - min), 0, 1)
		fill.Size = UDim2.new(ratio, 0, 1, 0)
		knob.Position = UDim2.new(ratio, -6, 0.5, -6)
		valueLabel.Text = tostring(value) .. (suffix or "")
	end)

	return holder
end

